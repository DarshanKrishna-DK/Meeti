APP_NAME=Meeti
NEXT_PUBLIC_APP_NAME=Meeti
APP_ORIGIN=http://127.0.0.1:3173
DATABASE_PATH=.local-data/meeti.sqlite
# Select postgres explicitly for the hosted backend. A credential alone does not switch local tests.
DATABASE_PROVIDER=sqlite
# Set true only for the Vercel backend deployment, with Postgres and durable tasks configured.
MEETI_SERVERLESS=false
# Lower read bursts when using a shared public Sepolia RPC. No retry can override a denied authority check.
ENS_RPC_READ_INTERVAL_MS=600
ENS_RPC_BATCH_SIZE=1
SUPABASE_DATABASE_URL=
SUPABASE_DATABASE_CA=
AGENT_TASK_QUEUE_ENABLED=false
# Set only on the separate Vercel frontend. Leave empty for local full-app development.
BACKEND_API_ORIGIN=
# Run npm run setup to generate a random encryption key in .env.local.
DATA_ENCRYPTION_KEY=
# Optional encrypted originals in a private Supabase Storage bucket.
# Encrypted originals use a private bucket. Hosted accounts and metadata use the private Postgres schema.
SUPABASE_STORAGE_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# OpenAI-compatible provider. Configure server-side only.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_REQUESTS=24
AI_MAX_COST_USD=0.25
# Hosted processing requires a pre-provisioned durable allowance. Restarting does not reset it.
AI_GLOBAL_BUDGET_ID=
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
# Select a provider-supported default. Every mode retains strict local validation.
AI_RESPONSE_FORMAT=json_object
# Optional explicit task map, for example {"evaluate_compatibility":"json_schema","agent_clarification":"json_schema"}.
AI_TASK_RESPONSE_FORMATS={}
# Optional for providers and models that support this parameter.
AI_REASONING_EFFORT=
AI_MAX_OUTPUT_TOKENS=1200
# Semantic comparison uses public intent subjects only. No vector database is required.
EMBEDDING_PROTOCOL=ollama
# Free hosted CPU option: onnx. Run node scripts/prepare-embedding-model.mjs first.
EMBEDDING_ONNX_DIRECTORY=.models/meeti-minilm-q8
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_MODEL_REVISION=
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=
EMBEDDING_INPUT_USD_PER_MILLION=0
EMBEDDING_MAX_COST_USD=0
EMBEDDING_MAX_REQUESTS=48
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_BATCH=16
EMBEDDING_RETRIES=1
# Calibrate on development examples for this exact model revision. Never tune on held-out results.
MATCHING_MIN_COSINE=
MATCHING_CALIBRATED_REVISION=
MATCHING_CALIBRATED_FORMAT=
# ENS and Arkiv settings are documented by their adapter env examples.
ENS_RPC_URL=
ENS_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Persistent current-block permission reads avoid inconsistent load-balanced HTTP tips.
ENS_SEPOLIA_AUTH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_PROJECT_PARENT=meeti-demo.eth
# Issuer must actually control the configured Sepolia parent. No server signing key.
ENS_PROJECT_ISSUER=
# Public network reference. Runtime rabdi({ accessKey }) constructs the keyed URL at this official base.
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_ACCESS_KEY=
# Official World Agent Pass OIDC portal credentials, separate from IDKit.
WORLD_CAPABILITY_ENABLED=false
WORLD_ISSUER=https://sandbox.auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_CLIENT_AUTH_METHOD=client_secret_basic
