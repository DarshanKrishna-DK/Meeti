{
  "name": "meeti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3173",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3173",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "setup": "node scripts/setup.mjs",
    "onboarding:fresh": "node scripts/fresh-onboarding.mjs",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "arkiv:query": "tsx --env-file=.env.local arkiv/query.ts",
    "worker:discovery": "tsx --env-file=.env.local scripts/discovery-worker.ts",
    "check:secrets": "node scripts/secret-scan.mjs",
    "demo:doctor": "tsx --env-file=.env.local scripts/demo-doctor.ts",
    "matching:live": "tsx --env-file=.env.local packages/matching/evaluate-live.ts",
    "matching:accounts": "tsx --env-file=.env.local scripts/live-matching.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@huggingface/transformers": "4.3.2",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "^0.552.0",
    "next": "^16.0.0",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
